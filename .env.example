# Copy to .env and fill in what you want to enable. Everything has a safe
# default and unset optional integrations are skipped (not faked).

ATM_ID=ATM-001
ATM_LOCATION=Canara Bank ATM, Madanapalle

# Rotate this in any real deployment — the default is an insecure dev value.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: email alerts (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Optional: Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: emergency alert to this ATM's nearest police station, sent
# automatically for weapon-lockdown and face-covering-siren events only.
# Reuses the SMTP settings above to send — fill in the REAL, verified
# contact for your actual nearest station, not a placeholder. Leaving this
# blank just skips the police channel (logged, not faked); it does not
# disable the admin email/Telegram alerts above.
POLICE_STATION_NAME=
POLICE_EMAIL=
POLICE_PHONE=

# "auto" picks CUDA if available, else CPU
DEVICE_PREFERENCE=auto
